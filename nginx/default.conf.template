# Processado pelo entrypoint do nginx com envsubst: apenas ${PORT} e ${BACKEND_HOST}
# são substituídos (variáveis de ambiente); $uri/$host etc. são do próprio nginx.
#
# BACKEND_HOST é o host do backend no Cloud Run (ingress interno), sem https://.
# O Cloud Run roteia pelo Host e pelo SNI, por isso os dois levam o host do backend;
# o host original do navegador segue em X-Forwarded-Host.
# O resolver com variável faz o nginx renovar o DNS do run.app em vez de fixar o IP do boot.
resolver 169.254.169.254 valid=300s ipv6=off;

server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    set $backend https://${BACKEND_HOST};

    # --- SSE (/api/v1/events): streaming exige buffering off e timeout longo ---
    location /api/v1/events {
        proxy_pass $backend;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- API: proxy para o backend no Cloud Run (ingress interno, via VPC) ---
    location /api/ {
        proxy_pass $backend;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    # Assets com hash no nome - cache imutável
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA - fallback para index.html (TanStack Router)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
